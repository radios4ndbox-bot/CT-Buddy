# Copia questo file in .env e inserisci i dati del tuo progetto Supabase
# (Dashboard → Project Settings → API). La chiave publishable è pensata per stare nelle app.
# NON inserire mai qui la chiave segreta (sb_secret_… / service_role).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
